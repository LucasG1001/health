# Conexão local de desenvolvimento: Postgres do docker-compose.dev.yml (npm run db:up).
DATABASE_URL=postgresql://health:health@localhost:5433/health

# Banco dos testes de integração (npm run test:integration). Precisa terminar em _test:
# os testes truncam as tabelas.
TEST_DATABASE_URL=postgresql://health:health@localhost:5433/health_test

# Porta da API (o frontend em dev faz proxy de /api para esta porta).
PORT=3333

# Diretório onde as imagens enviadas são gravadas (default: ./uploads).
UPLOAD_DIR=
